# Copy to .env (Docker Compose, repo root) or server/.env (local `npm run dev`).
# Never commit the real .env.

# ---- server (every env var read by server/src) ----
PORT=5000
# Local dev value. Docker Compose overrides it to mongodb://mongo:27017/eventpass.
MONGO_URI=mongodb+srv://bharath:Bharath2005@cluster0.9gwtl.mongodb.net/devops
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET=eventpassconnect
# Public URL of the web app; encoded into the QR code as <APP_BASE_URL>/verify?token=...
# Local dev with Vite: http://localhost:5173 · Docker Compose: http://localhost:8080
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# ---- docker compose image names (used by `docker compose pull` on EC2) ----
DOCKER_USERNAME=cleancode08
IMAGE_TAG=latest

# ---- grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
